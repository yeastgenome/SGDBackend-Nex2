                "parameters": [{
                    "name": "locusId",
                    "in": "path",
                    "description": "ID of locus to return",
                    "required": true,
                    "type": "string"
                }],
                "responses": {
                    "200": {
                        "description": "interaction annotations and the references used to make them",
                        "schema": {
                            "type": "array",
