                    "type": "string"
                }],
                "responses": {
                    "200": {
                        "description": "sequences for neighboring loci in the strains for which they are available",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "/locus/{locusId}/posttranslational_details": {
