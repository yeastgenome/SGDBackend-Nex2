                "parameters": [{
                    "name": "locusId",
                    "in": "path",
                    "description": "ID of locus to return",
                    "required": true,
                    "type": "string"
                }],
                "responses": {
                    "200": {
                        "description": "sequence for genomic, coding, protein, and +/- 1KB sequence",
                        "schema": {
                            "type": "object"
                        }
                    }
                }
            }
        },
        "/locus/{locusId}/neighbor_sequence_details": {
